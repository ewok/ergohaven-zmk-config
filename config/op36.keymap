#include "keys_ru.h"
#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35 30 31 32>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        lt_tap: lt_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        switch {
            bindings = <&kp LG(SPACE)>;
            key-positions = <31 34>;
            layers = <0>;
            timeout-ms = <1000>;
        };

        btl {
            bindings = <&mo 6>;
            key-positions = <30 32>;
            layers = <0>;
        };

        btr {
            bindings = <&mo 6>;
            key-positions = <33 35>;
            layers = <0>;
        };

        mouse {
            bindings = <&mo 3>;
            key-positions = <33 34>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <4 3>;
            layers = <1>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <13 14>;
            layers = <1>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <3 2>;
            layers = <1>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <2 1>;
            layers = <1>;
        };

        amp {
            bindings = <&kp AMPS>;
            key-positions = <13 12>;
            layers = <1>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <7 8>;
            layers = <1>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
            timeout-ms = <1500>;
            layers = <1>;
        };

        mouse2 {
            bindings = <&mo 3>;
            key-positions = <32 31>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &hml LCMD Q   &kp W  &kp E  &kp R          &kp T                                                          &kp Y             &kp U          &kp I      &kp O    &hmr RCMD P
  &hml LCTRL A  &kp S  &kp D  &kp F          &kp G                                                          &kp H             &kp J          &kp K      &kp L    &hmr RCTRL SEMI
  &hml LALT Z   &kp X  &kp C  &kp V          &kp B                                                          &kp N             &kp M          &kp COMMA  &kp DOT  &hmr RIGHT_ALT SLASH
                              &lt_tap 2 TAB  &hml LEFT_SHIFT SPACE  &lt_hold 1 RET    &lt_hold 1 BACKSPACE  &hmr RSHFT SPACE  &lt_tap 2 F12
            >;

            display-name = "Base";
        };

        sym_en {
            bindings = <
  &hml LCMD N1         &kp N2        &kp N3        &kp N4     &kp N5                              &kp PERCENT            &kp UNDER         &kp HASH         &kp BACKSLASH  &hmr RCMD LEFT_BRACKET
  &hml LCTRL NUMBER_6  &kp NUMBER_7  &kp N8        &kp N9     &kp N0                              &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET  &kp LEFT_BRACE   &kp LESS_THAN  &hmr RCTRL SINGLE_QUOTE
  &hml LEFT_ALT EQUAL  &kp SLASH     &kp ASTERISK  &kp MINUS  &kp PLUS                            &kp RIGHT_PARENTHESIS  &kp RBKT          &kp RIGHT_BRACE  &kp GT         &hmr RIGHT_ALT DOUBLE_QUOTES
                                                   &kp ESC    &trans    &kp RET    &kp BACKSPACE  &trans                 &kp GRAVE
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp LCMD               &kp F1  &kp F2   &kp F3       &kp F4                      &kp C_MUTE  &kp C_VOL_DN    &kp C_VOLUME_UP  &kp C_BRI_DN  &hmr RCMD C_BRI_UP
  &kp LCTRL              &kp F5  &kp F6   &kp F7       &kp F8                      &kp LEFT    &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT     &hmr RCTRL CAPSLOCK
  &hml LALT PRINTSCREEN  &kp F9  &kp F10  &kp F11      &kp F12                     &kp HOME    &kp PG_DN       &kp PG_UP        &kp END       &hmr RIGHT_ALT RC(PRINTSCREEN)
                                          &kp LS(TAB)  &trans   &trans    &kp DEL  &trans      &kp TILDE
            >;

            display-name = "Navigation";
        };

        mouse {
            display-name = "Navigation";
            bindings = <
  &kp LCMD   &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &mkp MCLK                          &mkp MCLK       &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp RGUI
  &kp LCTRL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none                              &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp RCTRL
  &kp LALT   &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN   &msc SCRL_RIGHT                    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &kp RALT
                                             &trans           &trans           &trans    &trans  &trans          &trans
            >;
        };

        gaming {
            bindings = <
  &kp CAPS   &kp Q  &kp W  &kp E     &kp R                                  &kp T    &kp Y   &kp U  &kp I  &kp O
  &kp LSHFT  &kp A  &kp S  &kp D     &kp F                                  &kp G    &kp H   &kp J  &kp K  &kp L
  &kp LCTRL  &kp Z  &kp X  &kp C     &kp V                                  &kp B    &kp N   &kp M  &kp P  &trans
                           &kp LALT  &kp SPACE  &lt_hold 5 RET    &kp BSPC  &kp TAB  &trans
            >;
        };

        num_gaming {
            bindings = <
  &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4                    &trans  &trans  &trans  &trans  &trans
  &kp F5   &kp N5  &kp N6  &kp N7  &kp N8                    &trans  &trans  &trans  &trans  &trans
  &kp F8   &kp M   &kp I   &kp N9  &kp N0                    &trans  &trans  &trans  &trans  &trans
                           &to 0   &trans  &trans    &trans  &trans  &to 0
            >;
        };

        adj {
            bindings = <
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
  &none         &none         &none         &bt BT_CLR    &out OUT_BLE                    &out OUT_BLE  &bt BT_CLR    &none         &none         &none
  &bootloader   &none         &none         &none         &out OUT_USB                    &out OUT_USB  &none         &none         &none         &studio_unlock
                                            &trans        &to 4         &trans    &trans  &to 4         &trans
            >;

            display-name = "Adjust";
        };
    };
};
